{
  "name": "volaresim",
  "productName": "VolareSIM",
  "version": "0.5.0",
  "description": "Simple civil flight simulator (Cessna) built with Three.js - runs in the browser and as a Windows desktop app",
  "author": "marcko80",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --port 5173",
    "build": "vite build",
    "preview": "vite preview",
    "app": "vite build && electron .",
    "dist": "vite build && electron-builder --win --publish never",
    "screenshots": "vite build && node tools/screenshots.mjs"
  },
  "dependencies": {
    "three": "^0.187.0",
    "vite": "^8.3.8"
  },
  "devDependencies": {
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.volaresim.app",
    "productName": "VolareSIM",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "electron/**",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "portable": {
      "artifactName": "VolareSIM-Portable-${version}.exe"
    },
    "nsis": {
      "artifactName": "VolareSIM-Setup-${version}.exe",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false
    }
  }
}
